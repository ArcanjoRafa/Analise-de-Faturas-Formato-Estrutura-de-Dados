-- Banco: fatura
-- Ordem de criação respeita as chaves estrangeiras (tabelas "pai" primeiro).

-- 1) Sem dependências -------------------------------------------------------

create table clientes(
	id BIGINT generated by default as identity primary key,
	nome text not null,
	cpf_cnpj varchar(30) not null
);

create table medidor(
	id BIGINT generated by default as identity primary key,
	numero varchar(50) not null
);

-- 2) Dependem de clientes / medidor ------------------------------------------

create table unidadeconsumidora(
	id BIGINT generated by default as identity primary key,
	uc varchar(50) not null,
	endereco text not null,
	cep text,
	cliente_id BIGINT not null,

	foreign key (cliente_id) references clientes(id)
);

-- 3) Depende de unidadeconsumidora e medidor ---------------------------------

create table fatura(
	id BIGINT generated by default as identity primary key,
	valor_total numeric(10,2) not null,
	vencimento date not null,
	mes_ref varchar(50) not null,
	uc_id BIGINT not null,
	medidor_id BIGINT not null,

	foreign key (uc_id) references unidadeconsumidora(id),
	foreign key (medidor_id) references medidor(id)
);

-- 4) Dependem de fatura -------------------------------------------------------

create table leitura(
	id BIGINT generated by default as identity primary key,
	l_anterior date not null,
	l_atual date not null,
	dias integer not null,
	l_proxima date not null,
	fatura_id BIGINT not null,

	foreign key (fatura_id) references fatura(id)
);

create table tributo(
	id BIGINT generated by default as identity primary key,
	nome varchar(50) not null,
	aliquota numeric(5,2) not null,
	base_calc numeric(10,2) not null,
	valor numeric(10,2) not null,
	fatura_id BIGINT not null,

	foreign key (fatura_id) references fatura(id)
);

create table item_fatura(
	id BIGINT generated by default as identity primary key,
	nome_item varchar(100) not null,
	unid varchar(20),
	quant numeric(10,4),
	preco_unit numeric(10,4),
	valor_total numeric(10,2),
	pis_cofins numeric(10,2),
	base_calc_icms numeric(10,2),
	aliq_icms numeric(10,2),
	icms numeric(10,2),
	tarifa_unit numeric(10,4),
	fatura_id BIGINT not null,

	foreign key (fatura_id) references fatura(id)
);

-- 5) Depende de medidor e fatura ----------------------------------------------

create table sumarioeletrico(
	id BIGINT generated by default as identity primary key,
	grandeza varchar(50) not null,
	posto_h varchar(10) not null,
	l_anterior numeric(10,4) not null,
	l_atual numeric(10,4) not null,
	const numeric(10,4) not null,
	consumo numeric(10,2),
	medidor_id BIGINT not null,
	fatura_id BIGINT not null,

	foreign key (medidor_id) references medidor(id),
	foreign key (fatura_id) references fatura(id)
);